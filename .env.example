# Copy to .env and adjust.

# Database
# - empty (default): SQLite file created automatically in DATA_DIR
# - PostgreSQL:      postgresql://USER:PASSWORD@HOST:5432/DBNAME
# - explicit SQLite: sqlite:///data/seznam-mail-mcp.db  (relative)  or  sqlite:////abs/path.db
DATABASE_URL=

# Directory for local data (SQLite file when DATABASE_URL is empty)
DATA_DIR=data

# stdio mode only (single user): `seznam-mail-mcp stdio`
SEZNAM_EMAIL=
SEZNAM_APP_PASSWORD=

# HTTP mode (`seznam-mail-mcp serve`)
# Public HTTPS URL of this server (OAuth issuer); clients connect to $PUBLIC_URL/mcp
PUBLIC_URL=https://mail.mcp.example.com
HOST=127.0.0.1
PORT=3856
# Encryption key for stored mailbox credentials (created on first start). Back it up!
SECRET_KEY_FILE=data/secret.key
# OAuth redirect URIs accepted at client registration (comma separated). Default: Claude + ChatGPT
#ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect
# Allow http://localhost:<port> redirects (Claude Code, MCP Inspector, desktop apps)
ALLOW_LOOPBACK_REDIRECTS=true
#ACCESS_TOKEN_TTL=3600
# Refresh token lifetime in seconds. Renewed on every use, so it only limits inactivity (default 180 days)
#REFRESH_TOKEN_TTL=15552000

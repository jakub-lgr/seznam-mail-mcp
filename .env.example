# Copy to .env and adjust.

# Database
# - empty (default): SQLite file created automatically in DATA_DIR
# - PostgreSQL:      postgresql://USER:PASSWORD@HOST:5432/DBNAME
# - explicit SQLite: sqlite:///data/seznam-mail-mcp.db  (relative)  or  sqlite:////abs/path.db
DATABASE_URL=

# Directory for local data (SQLite file when DATABASE_URL is empty)
DATA_DIR=data

# stdio mode only (single user): `seznam-mail-mcp stdio`
SEZNAM_EMAIL=
SEZNAM_APP_PASSWORD=
